<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NewWebSL-Login</title>
    <link rel="stylesheet" href="css/login-style.css"/>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kdam+Thmor+Pro&display=swap" rel="stylesheet">
</head>
<body>
    <img src="imgs/svgs/lock-svg.svg" id="lock-img-background"/>

        <form method="POST" action="http://<%= ipv4 %>:3000/loginAccount" id="login-container" autocomplete="off">
            <input class="input-login" id="email" placeholder="Email" name="email" type="text">
            <input class="input-login" id="password" placeholder="Senha" name="password" type="password">
            <input type="submit" class="input-login" id="button" value="Entrar">
        </form>

</body>
</html>