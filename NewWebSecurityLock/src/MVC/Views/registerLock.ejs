<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NewWebSl-Register-Lock</title>

    <link rel="stylesheet" href="css/register-style.css"/>
    <link rel="stylesheet" href="css/navbar-worker-style.css"/>


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kdam+Thmor+Pro&display=swap" rel="stylesheet">
</head>
<body>
    <div id="main-grid">
        <%- include ("../../../rsrc/public/templates/navbar-worker.ejs"); %>

        <form method="POST" action="http://<%= ipv4 %>:3000/registerLock" id="register-container" autocomplete="off">
            <div id="form-title">Registrar Fechadura</div>
            <input class="input-container" id="account_id" placeholder="ID Dono"  name="account_id" type="text">
            <input class="input-container" id="name" placeholder="Nome" name="lock_name" type="text">
            <input class="input-container" id="password" placeholder="Senha" name="password" type="password">
            <input type="submit" id="register-button" value="Registrar">
        </form>

    </div>
</body>
</html>